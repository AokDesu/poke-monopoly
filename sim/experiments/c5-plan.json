  "policies": [
    {
      "id": "always-pvp",
      "label": "Always PvP",
      "spec": "§4.4–4.5; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "Declares or accepts a legal voluntary PvP challenge whenever one is enabled.",
      "upstream": ["A61-1"]
    },
    {
      "id": "force-weak-target",
      "label": "Force weak targets",
      "spec": "§4.4–4.5; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "Uses an enabled Rival, Battle Ticket or Challenge force against the weakest public-information target; otherwise baseline.",
      "upstream": ["A61-1"]
    },
    {
      "id": "sell-all",
      "label": "Sell everything every Start",
      "spec": "§4.7; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "At every Start Sell Phase sells every enabled sellable Pokemon in one atomic batch.",
      "upstream": ["A61-2"]
    },
    {
      "id": "keep-to-evolve",
      "label": "Keep everything to evolve",
      "spec": "§4.5, §4.7; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "Declines discretionary sales and takes enabled evolution rewards; the engine's mandatory final sale still happens.",
      "upstream": ["A61-2"]
    },
    {
      "id": "immediate-ability",
      "label": "Use Abilities immediately",
      "spec": "§4.5, Appendix C; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "Uses an Ability at the earliest enabled timing opportunity, never past cooldown or action budgets.",
      "upstream": ["A61-1"]
    },
    {
      "id": "ultra-only",
      "label": "Buy only Ultra Balls",
      "spec": "§4.2–4.3, Appendix A; §8 Critic",
      "socialWindow": false,
      "focalBehaviour": "Buys only Ultra Balls in discretionary Shop purchases; skips the Shop if none are offered.",
      "upstream": ["A61-2"]
    },
    {
      "id": "never-negotiate",
      "label": "Never negotiate",
      "spec": "§4.8; §8 Critic",
      "socialWindow": true,
      "focalBehaviour": "Skips Social and rejects every enabled deal or promise response; baseline elsewhere.",
      "upstream": [
        "A61-2",
        "AokDesu/poke-monopoly#164 (Deal Cards)",
        "AokDesu/poke-monopoly#198 (promise settlement)"
      ]
    }
  ],
