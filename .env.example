# Copy to .env (git-ignored). The two keys are read by ai/ only and never reach the browser or an agent's sandbox.
# Haiku inside the game is a product part chosen by the repository owner, not a tool the team's builders use.
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-1.13.0
ANTHROPIC_API_KEY=
HAIKU_ENABLED=false
