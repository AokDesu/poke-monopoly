exports[`wording and options > a snapshot records the wording for a promise offered to the AI and one it is asked for 1`] = `
{
  "asked": {
    "promise_response": {
      "criteria": {
        "accept": "Accept. You promise P2 not to attack them until the end of your next turn: no PvP declaration, no hostile item and no hostile Ability against them. The promise is recorded. Nothing stops you from breaking it, but if you do, P2's trust in you falls and they remember it; if you keep it, their trust in you may rise.",
