{
  "name": "poke-monopoly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env ai/server.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "tsx --env-file-if-exists=.env ai/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "sim": "tsx sim/cli.ts",
    "eval:jev": "tsx eval/jev/cli.ts"
  },
  "dependencies": {
    "@fontsource/mitr": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@hono/node-server": "2.1.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@typesafe-ai/sdk": "0.6.0",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
